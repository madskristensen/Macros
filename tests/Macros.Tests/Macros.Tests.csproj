<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Macros.Tests</RootNamespace>
    <AssemblyName>Macros.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);VSTHRD003;VSTHRD103</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Engine references Microsoft.VisualStudio.Threading via the VS SDK with ExcludeAssets=Runtime,
         so the runtime DLL isn't deployed transitively. Reference it directly for unit tests. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.10.48" />
    <!-- Used by CommandHandlerSmokeTests to inspect [Command] attributes on the VSIX assembly
         without runtime-loading its VS Shell dependencies. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
    <!-- Macros.Engine references the VS SDK with ExcludeAssets=Runtime, so EnvDTE / EnvDTE80
         interop assemblies and Microsoft.VisualStudio.Shell.15.0 are not deployed to the test
         bin. MacroPlayerTests construct a MacroPlayer whose ctor takes EnvDTE80.DTE2 and whose
         compile path resolves typeof(Package).Assembly; both must be loadable at JIT/runtime.
         Pull the runtime DLLs into the test bin directly. -->
    <PackageReference Include="EnvDTE" Version="17.10.40170" />
    <PackageReference Include="EnvDTE80" Version="17.10.40170" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.10.40170" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Macros.Engine\Macros.Engine.csproj" />
    <!-- ReferenceOutputAssembly=true: M3 added pure MVVM / view-model types to the VSIX project
         (RelayCommand, MacrosToolWindowViewModel, SaveAsDialogViewModel) that need to be
         referenced by unit tests. The VSIX DLL is safe to load in a test process because all
         referenced types have no static VS-shell initialisation; the test project already
         pulls in the required VS runtime assemblies (Shell.15.0, EnvDTE, EnvDTE80) for this
         purpose. CommandHandlerSmokeTests continues to use MetadataLoadContext rather than
         the loaded type directly, so that isolation guarantee is unchanged. -->
    <ProjectReference Include="..\..\src\Macros\Macros.csproj" />
  </ItemGroup>

  <!-- Snapshot fixtures for CSharpCodeGeneratorTests. The golden .csx files are read at
       test runtime from AppContext.BaseDirectory; copy them to the test bin alongside the
       compiled assemblies. -->
  <ItemGroup>
    <Content Include="Codegen\golden\*.csx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
