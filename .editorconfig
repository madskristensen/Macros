root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,vsct,vsixmanifest,csproj,props,targets,xaml,xml,slnx}]
indent_size = 2

[*.cs]
# C# code style — light defaults; engine team can tune later
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0005.severity = warning   # using directive is unnecessary

# VSTHRD analyzers — strict on threading
dotnet_diagnostic.VSTHRD010.severity = warning
dotnet_diagnostic.VSTHRD100.severity = error
dotnet_diagnostic.VSTHRD110.severity = warning
dotnet_diagnostic.VSTHRD200.severity = silent  # async naming — too noisy for VSIX

# CVST005: "command not initialized via reflection sweep" — suppressed because we use
# explicit BaseCommand<T>.InitializeAsync(this) calls in a private RegisterCommandsAsync()
# helper instead of the toolkit's reflection-based this.RegisterCommandsAsync() extension.
dotnet_diagnostic.CVST005.severity = none
