<UserControl x:Class="Macros.Options.TrustedSolutionsPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             AutomationProperties.Name="Trusted solutions options"
             d:DesignHeight="400" d:DesignWidth="600">

  <!-- Accessibility:
       - UserControl carries AutomationProperties.Name so the Tools > Options page reads as
         "Trusted solutions options" in screen readers.
       - The Trusted / Blocked column headers (TextBlocks) are referenced by the matching
         ListBoxes via AutomationProperties.LabeledBy, so each list announces a meaningful
         role + name.
       - Move buttons (→ / ←) carry both AutomationProperties.Name (Narrator label) and a
         ToolTip (mouse hint) because their Content is a non-readable arrow glyph.
       - Action buttons use access keys (_Add Trusted…, Add _Blocked…, _Remove) so Alt+T /
         Alt+B / Alt+R reach them without leaving the keyboard.
       - Tab order follows document order: Trusted list → Move-to-Blocked → Move-to-Trusted
         → Blocked list → Add Trusted → Add Blocked → Remove.
       - All colours come from EnvironmentColors so high-contrast themes inherit correctly.
  -->

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Column headers -->
    <TextBlock Grid.Row="0" Grid.Column="0"
               x:Name="TrustedHeader"
               Text="Trusted Solutions"
               FontWeight="SemiBold"
               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
               Margin="0,0,0,4"/>
    <TextBlock Grid.Row="0" Grid.Column="2"
               x:Name="BlockedHeader"
               Text="Blocked Solutions"
               FontWeight="SemiBold"
               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
               Margin="0,0,0,4"/>

    <!-- Trusted list -->
    <ListBox Grid.Row="1" Grid.Column="0"
             x:Name="TrustedList"
             SelectionMode="Extended"
             AutomationProperties.LabeledBy="{Binding ElementName=TrustedHeader}"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
             Margin="0,0,4,0"/>

    <!-- Move buttons -->
    <StackPanel Grid.Row="1" Grid.Column="1"
                Margin="4,0"
                VerticalAlignment="Center">
      <Button x:Name="MoveToBlockedButton"
              Content="→"
              ToolTip="Move selected to Blocked"
              AutomationProperties.Name="Move selected to Blocked"
              Width="32" Margin="0,0,0,8"
              Click="MoveToBlocked_Click"/>
      <Button x:Name="MoveToTrustedButton"
              Content="←"
              ToolTip="Move selected to Trusted"
              AutomationProperties.Name="Move selected to Trusted"
              Width="32"
              Click="MoveToTrusted_Click"/>
    </StackPanel>

    <!-- Blocked list -->
    <ListBox Grid.Row="1" Grid.Column="2"
             x:Name="BlockedList"
             SelectionMode="Extended"
             AutomationProperties.LabeledBy="{Binding ElementName=BlockedHeader}"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
             Margin="4,0,0,0"/>

    <!-- Action buttons row -->
    <StackPanel Grid.Row="2" Grid.ColumnSpan="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,8,0,0">
      <Button x:Name="AddTrustedButton"
              Content="_Add Trusted…"
              AutomationProperties.Name="Add trusted solution"
              MinWidth="90" Margin="0,0,8,0"
              Click="AddTrusted_Click"/>
      <Button x:Name="AddBlockedButton"
              Content="Add _Blocked…"
              AutomationProperties.Name="Add blocked solution"
              MinWidth="90" Margin="0,0,8,0"
              Click="AddBlocked_Click"/>
      <Button x:Name="RemoveButton"
              Content="_Remove"
              AutomationProperties.Name="Remove selected entries"
              MinWidth="70"
              Click="Remove_Click"/>
    </StackPanel>
  </Grid>
</UserControl>
