<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!--
    Macros for Visual Studio - Command Table
    ========================================
    This file is the single source of truth for menus, toolbars, buttons, key bindings,
    and visibility constraints exposed by the extension.

    M1 milestone breakdown:
      * m1-vsct-symbols       (this todo) - locks the Symbols section so other todos can
                                            reference IDs without renumbering churn.
      * m1-vsct-toolbar       - fills <Menus> and <Groups> (main toolbar, tool window
                                            toolbar, context menu).
      * m1-vsct-buttons       - fills <Buttons> for each cmdid* symbol below.
      * m1-vsct-keybindings   - fills <KeyBindings>.
      * m1-vsct-visibility    - fills <VisibilityConstraints> against guidMacrosRecordingContext.
  -->

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <!-- Standard VS menu/group/anchor IDs used by later todos (e.g., View > Other Windows). -->
  <Include href="VSGlobals.vsct" />

  <!-- KnownMonikers image catalog symbols (ImageCatalogGuid + every <IDSymbol> name from
       Microsoft.VisualStudio.Imaging.KnownMonikers). Required so VSCT-defined buttons can
       say <Icon guid="ImageCatalogGuid" id="Run" /> with CommandFlag IconIsMoniker. -->
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidMacrosPackage">

    <Menus>
      <Menu guid="guidMacrosPackageCmdSet" id="MacrosToolbar" type="Toolbar">
        <Strings>
          <ButtonText>Macros</ButtonText>
          <CommandName>Macros</CommandName>
        </Strings>
      </Menu>

      <!-- Tool window toolbar: hosts Record, Stop, and Refresh directly on the Macros tool
           window chrome. Record/Stop are placed here via CommandPlacements so they keep
           their main IDE toolbar placement too. Refresh is native to this toolbar. -->
      <Menu guid="guidMacrosPackageCmdSet" id="MacrosToolWindowToolbar" type="ToolWindowToolbar">
        <Strings>
          <ButtonText>Macros Window Toolbar</ButtonText>
          <CommandName>Macros.ToolWindowToolbar</CommandName>
        </Strings>
      </Menu>

      <!-- Tool window context menu (m3-context-menu). Shown via IVsUIShell.ShowContextMenu
           from MacrosToolWindowControl on right-click over a macro row. The selected macro
           is supplied through MacroSelectionContext before the menu opens. -->
      <Menu guid="guidMacrosPackageCmdSet" id="MacrosToolWindowContextMenu" priority="0x0000" type="Context">
        <Strings>
          <ButtonText>Macro Context Menu</ButtonText>
          <CommandName>Macros.MacrosContextMenu</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidMacrosPackageCmdSet" id="MacrosToolbarGroup" priority="0x0000">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolbar" />
      </Group>

      <!-- Group on the tool window toolbar. Record and Stop are placed here via
           CommandPlacements; Refresh is parented here directly. -->
      <Group guid="guidMacrosPackageCmdSet" id="MacrosToolWindowToolbarGroup" priority="0x0000">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolWindowToolbar" />
      </Group>

      <!-- Group 1: primary actions on a single macro row. -->
      <Group guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup1" priority="0x0100">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolWindowContextMenu" />
      </Group>
      <!-- Group 2: secondary "navigate to" actions; the priority gap makes VS render a
           separator between the two groups automatically. -->
      <Group guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup2" priority="0x0200">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolWindowContextMenu" />
      </Group>

      <!-- Group 3: file-system navigation actions. -->
      <Group guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup3" priority="0x0300">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolWindowContextMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosRecord" priority="0x0100" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Record" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Record Macro</ButtonText>
          <CommandName>Macros.Record</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosStop" priority="0x0101" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Stop" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Stop Recording</ButtonText>
          <CommandName>Macros.Stop</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosPlayLast" priority="0x0110" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolbarGroup" />
        <Strings>
          <ButtonText>Play Last Macro</ButtonText>
          <CommandName>Macros.PlayLast</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosShowWindow" priority="0x0120" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolbarGroup" />
        <Strings>
          <ButtonText>Show Macros Window</ButtonText>
          <CommandName>Macros.ShowWindow</CommandName>
        </Strings>
      </Button>

      <!-- Kill-switch toggle (m4-kill-switch). Appears as a checked toolbar button;
           checked state = triggers are disabled. -->
      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosToggleTriggers" priority="0x0130" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolbarGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Toggle All Triggers</ButtonText>
          <CommandName>Macros.ToggleTriggers</CommandName>
        </Strings>
      </Button>

      <!-- Tool window context menu buttons (m3-context-menu). Each acts on the macro stored
           in MacroSelectionContext.Current at right-click time. KnownMonikers IDs come from
           Microsoft.VisualStudio.Imaging.KnownMonikers; ImageCatalogGuid is the well-known
           {ae27a6b0-e345-4288-96df-5eaf394ee369}. -->
      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxPlay" priority="0x0100" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup1" />
        <Icon guid="ImageCatalogGuid" id="Run" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>&amp;Play</ButtonText>
          <CommandName>Macros.Context.Play</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxEdit" priority="0x0110" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup1" />
        <Icon guid="ImageCatalogGuid" id="Edit" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>&amp;Edit Macro</ButtonText>
          <CommandName>Macros.Context.Edit</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxRename" priority="0x0120" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup1" />
        <Icon guid="ImageCatalogGuid" id="Rename" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>&amp;Rename...</ButtonText>
          <CommandName>Macros.Context.Rename</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxDelete" priority="0x0130" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup1" />
        <Icon guid="ImageCatalogGuid" id="Cancel" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>&amp;Delete</ButtonText>
          <CommandName>Macros.Context.Delete</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxMoveToRepo" priority="0x0100" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup2" />
        <Icon guid="ImageCatalogGuid" id="MoveToFolder" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Move to &amp;Repo</ButtonText>
          <CommandName>Macros.Context.MoveToRepo</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxMoveToGlobal" priority="0x0110" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup2" />
        <Icon guid="ImageCatalogGuid" id="MoveToFolder" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Move to &amp;Global</ButtonText>
          <CommandName>Macros.Context.MoveToGlobal</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxCopyToRepo" priority="0x0120" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup2" />
        <Icon guid="ImageCatalogGuid" id="Copy" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Copy to R&amp;epo</ButtonText>
          <CommandName>Macros.Context.CopyToRepo</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxCopyToGlobal" priority="0x0130" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup2" />
        <Icon guid="ImageCatalogGuid" id="Copy" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Copy to G&amp;lobal</ButtonText>
          <CommandName>Macros.Context.CopyToGlobal</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxManageTriggers" priority="0x0160" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup1" />
        <Icon guid="ImageCatalogGuid" id="EventTrigger" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Manage &amp;Triggers...</ButtonText>
          <CommandName>Macros.Context.ManageTriggers</CommandName>
        </Strings>
      </Button>

      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxOpenFolder" priority="0x0100" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosContextMenuGroup3" />
        <Icon guid="ImageCatalogGuid" id="FolderOpened" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Open Folder in &amp;Explorer</ButtonText>
          <CommandName>Macros.Context.OpenFolder</CommandName>
        </Strings>
      </Button>

      <!-- Tool window toolbar: Refresh button. Record and Stop are added to the same group
           via CommandPlacements below so they keep their main IDE toolbar placement too. -->
      <Button guid="guidMacrosPackageCmdSet" id="cmdidMacrosRefresh" priority="0x0100" type="Button">
        <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolWindowToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Refresh" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Refresh Macro List</ButtonText>
          <CommandName>Macros.Refresh</CommandName>
        </Strings>
      </Button>
    </Buttons>

  </Commands>

  <!-- Place Record and Stop on the tool window toolbar in addition to the main IDE toolbar.
       CommandPlacements lives outside <Commands> per the VSCT schema. -->
  <CommandPlacements>
    <CommandPlacement guid="guidMacrosPackageCmdSet" id="cmdidMacrosRecord" priority="0x0110">
      <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolWindowToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidMacrosPackageCmdSet" id="cmdidMacrosStop" priority="0x0111">
      <Parent guid="guidMacrosPackageCmdSet" id="MacrosToolWindowToolbarGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="guidMacrosPackageCmdSet" id="cmdidMacrosRecord" editor="guidVSStd97" key1="R" mod1="Control Shift" />
    <KeyBinding guid="guidMacrosPackageCmdSet" id="cmdidMacrosPlayLast" editor="guidVSStd97" key1="P" mod1="Control Shift" />

    <!-- Tool window scoped bindings (m3-context-menu polish):
         * Enter  -> Play   (default row activation; surfaces "Enter" as the gesture
                            text on the Play context menu item).
         * F2     -> Rename (matches Solution Explorer / file rename convention).
         The editor scope is guidMacrosToolWindow (the Macros tool window pane GUID),
         registered with the shell via [ProvideKeyBindingTable] on MacrosPackage so VS
         knows about the scope and auto-renders the gesture next to the matching menu
         items. The actual key handling happens in MacrosToolWindowControl.MacroRow_PreviewKeyDown
         because WPF list rows swallow Enter/F2 before the IDE keyboard chain sees them. -->
    <KeyBinding guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxPlay" editor="guidMacrosToolWindow" key1="VK_RETURN" />
    <KeyBinding guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxEdit" editor="guidMacrosToolWindow" key1="VK_F7" />
    <KeyBinding guid="guidMacrosPackageCmdSet" id="cmdidMacrosCtxRename" editor="guidMacrosToolWindow" key1="VK_F2" />
  </KeyBindings>

  <VisibilityConstraints>
    <VisibilityItem guid="guidMacrosPackageCmdSet" id="cmdidMacrosStop" context="guidMacrosRecordingContext" />
    <VisibilityItem guid="guidMacrosPackageCmdSet" id="cmdidMacrosRecord" context="guidMacrosNotRecordingContext" />
  </VisibilityConstraints>

  <Symbols>

    <!-- Package GUID. Mirrors PackageGuids.guidMacrosPackageString. -->
    <GuidSymbol name="guidMacrosPackage" value="{d13e532a-bd43-40df-ae9f-8d05e54138c7}" />

    <!-- Command set GUID. Mirrors PackageGuids.guidMacrosPackageCmdSetString. All menus, groups,
         and commands for the extension live under this set. -->
    <GuidSymbol name="guidMacrosPackageCmdSet" value="{1f6e8c4b-2d54-4a76-9c2c-9d8b5a7e1d31}">

      <!-- Menus / Groups (placeholders for m1-vsct-toolbar) -->
      <IDSymbol name="MacrosToolbar"                 value="0x1000" />
      <IDSymbol name="MacrosToolbarGroup"            value="0x1010" />
      <IDSymbol name="MacrosToolWindowToolbar"       value="0x1020" />
      <IDSymbol name="MacrosToolWindowToolbarGroup"  value="0x1030" />
      <IDSymbol name="MacrosContextMenu"             value="0x1040" />
      <IDSymbol name="MacrosContextMenuGroup"        value="0x1050" />

      <!-- Commands (placeholders for m1-vsct-buttons) -->
      <IDSymbol name="cmdidMacrosRecord"             value="0x0100" />
      <IDSymbol name="cmdidMacrosStop"               value="0x0101" />
      <IDSymbol name="cmdidMacrosPlayLast"           value="0x0102" />
      <IDSymbol name="cmdidMacrosPlayNamed"          value="0x0103" />
      <IDSymbol name="cmdidMacrosSaveAs"             value="0x0104" />
      <IDSymbol name="cmdidMacrosShowWindow"         value="0x0105" />
      <IDSymbol name="cmdidMacrosDelete"             value="0x0106" />
      <IDSymbol name="cmdidMacrosRename"             value="0x0107" />
      <IDSymbol name="cmdidMacrosEdit"               value="0x0108" />
      <IDSymbol name="cmdidMacrosManageTriggers"     value="0x0109" />
      <IDSymbol name="cmdidMacrosNewMacro"           value="0x010A" />
      <IDSymbol name="cmdidMacrosRefresh"            value="0x010B" />
      <IDSymbol name="cmdidMacrosMoveToRepo"         value="0x010C" />
      <IDSymbol name="cmdidMacrosMoveToGlobal"       value="0x010D" />
      <!-- M4 kill-switch toggle (m4-kill-switch). -->
      <IDSymbol name="cmdidMacrosToggleTriggers"     value="0x0014" />

      <!-- Tool window context menu (m3-context-menu). Lives in its own 0x2xxx range so it
           cannot collide with the M1 placeholders above and so the symbols cluster together. -->
      <IDSymbol name="MacrosToolWindowContextMenu"   value="0x2000" />
      <IDSymbol name="MacrosContextMenuGroup1"       value="0x2100" />
      <IDSymbol name="MacrosContextMenuGroup2"       value="0x2200" />
      <IDSymbol name="MacrosContextMenuGroup3"       value="0x2300" />
      <IDSymbol name="cmdidMacrosCtxPlay"            value="0x2110" />
      <IDSymbol name="cmdidMacrosCtxEdit"            value="0x2111" />
      <IDSymbol name="cmdidMacrosCtxRename"          value="0x2112" />
      <IDSymbol name="cmdidMacrosCtxDelete"          value="0x2113" />
      <IDSymbol name="cmdidMacrosCtxMoveToRepo"      value="0x2114" />
      <IDSymbol name="cmdidMacrosCtxMoveToGlobal"    value="0x2115" />
      <IDSymbol name="cmdidMacrosCtxManageTriggers"  value="0x2116" />
      <IDSymbol name="cmdidMacrosCtxCopyToRepo"      value="0x2117" />
      <IDSymbol name="cmdidMacrosCtxCopyToGlobal"    value="0x2118" />
      <IDSymbol name="cmdidMacrosCtxOpenFolder"      value="0x2210" />

    </GuidSymbol>

    <!-- UIContext GUID activated while recording. Drives VisibilityConstraints in
         m1-vsct-visibility. Mirrors PackageGuids.guidMacrosRecordingContextString. -->
    <GuidSymbol name="guidMacrosRecordingContext" value="{f0a5d2c7-7e7c-4a47-bc6f-2c0a5b6f2c80}" />

    <!-- Inverse UIContext: active when NOT recording. Drives Record button visibility
         in m1-vsct-visibility. Mirrors PackageGuids.guidMacrosNotRecordingContextString. -->
    <GuidSymbol name="guidMacrosNotRecordingContext" value="{c8e5a3b1-9f4d-4d87-b5a2-7e1f3a8c2d40}" />

    <!-- Editor/scope GUID for tool-window-scoped key bindings. Matches the
         MacrosToolWindow.Pane class GUID so KeyBindings under this scope activate only
         when the Macros tool window has focus. -->
    <GuidSymbol name="guidMacrosToolWindow" value="{a4c1b2d8-3e5f-4a6b-9c7d-8e0f1a2b3c4d}" />

  </Symbols>

</CommandTable>
