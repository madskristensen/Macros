<UserControl x:Class="Macros.ToolWindows.MacrosToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:local="clr-namespace:Macros.ToolWindows"
             mc:Ignorable="d"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             AutomationProperties.Name="Macros tool window"
             toolkit:Themes.UseVsTheme="True"
             d:DesignHeight="400" d:DesignWidth="320">

    <!-- Accessibility:
         - UserControl, toolbar buttons, filter box, list view, and per-row Play button all
           carry AutomationProperties.Name so screen readers announce a meaningful label.
         - ListViewItem.AutomationProperties.Name is bound to AutomationName which composes
           "Macro {Name}, {TriggersSummary}, modified {ModifiedRelative}" via
           AccessibilityHelpers.FormatMacroAutomationName.
         - Tab order is the natural document order: Refresh → Record → Filter → Macro list →
           per-row Play. KeyboardNavigation.TabIndex is left at default (positive integers
           would override container-aware focus and worsen Narrator behaviour).
         - Right-click and the Apps key (Shift+F10 is also accepted) both open the VSCT
           context menu via the code-behind handlers (MacroRow_PreviewMouseRightButtonUp /
           MacroRow_PreviewKeyDown) so mouse and keyboard reach the same commands.
         - The status banner uses AutomationProperties.LiveSetting="Polite" so error /
           recoverable-warning text is announced without interrupting the user.
         - Colours come from EnvironmentColors so high-contrast themes inherit correctly;
           focus rectangles are not suppressed (no Style strips FocusVisualStyle).
    -->

    <UserControl.Resources>
        <!-- Built-in WPF converter is sufficient for the simple bool→Visibility mappings the
             empty-state, error banner, and group headers need. No inversion required. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="GroupExpanderToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Chevron"
                                       Text="▶"
                                       Margin="6,0,6,0"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="▼" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource GroupExpanderToggleButtonStyle}"
                                          Content="{TemplateBinding Header}" />

                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="16,2,0,0"
                                              Visibility="Collapsed" />
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacroGridViewHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ToolWindowListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:TreeViewColors.BackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:TreeViewColors.BackgroundTextBrushKey}}" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <!-- Issue #5: 4px symmetric horizontal margin on the row Border so
                             the highlighted/selected background has an even gutter on both
                             sides and doesn't visually run into the tool-window edges. -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,0"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter
                                Content="{TemplateBinding Content}"
                                Columns="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=View.Columns}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:TreeViewColors.HighlightedSpanBrushKey}}" />
                            </Trigger>
                            <!-- Issue #5: the previous TreeViewColors.SelectedItemActiveBrushKey is the
                                 strong "selected tree node" color used by Solution Explorer. List-style
                                 tool windows (Test Explorer, Error List) use the milder
                                 EnvironmentColors.CommandBarSelectedBrushKey so the selection feels less
                                 aggressive; mirror that here. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarSelectedBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarTextSelectedBrushKey}}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarHoverBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarTextHoverBrushKey}}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacroListViewItemStyle"
               TargetType="ListViewItem"
               BasedOn="{StaticResource ToolWindowListViewItemStyle}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Row_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="MacroRow_PreviewMouseMove" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="MacroRow_PreviewMouseRightButtonUp" />
            <EventSetter Event="MouseDoubleClick" Handler="MacroRow_MouseDoubleClick" />
            <EventSetter Event="PreviewKeyDown" Handler="MacroRow_PreviewKeyDown" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShadowed}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="Opacity" Value="0.6" />
                    <Setter Property="ToolTip" Value="Shadowed by repo macro of the same name." />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSample}" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="4,0"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Padding="4,2" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource {x:Static vsui:TreeViewColors.HighlightedSpanBrushKey}}" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="Selector.IsSelectionActive" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarSelectedBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarTextSelectedBrushKey}}" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="Selector.IsSelectionActive" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarHoverBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarTextHoverBrushKey}}" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- ─── Status banner (errors only) ─────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.SystemInfoBackgroundBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Macros status"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemInfoTextBrushKey}}" />
        </Border>

        <!-- ─── Macro list / empty state ────────────────────────────────────────────────── -->
        <Grid>
            <ListView ItemsSource="{Binding GroupedItemsView}"
                      AutomationProperties.Name="Saved macros"
                      Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                      Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                      BorderThickness="0"
                      AllowDrop="True"
                      DragOver="MacroGroups_DragOver"
                      Drop="MacroGroups_Drop"
                      SelectionChanged="MacrosListView_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource MacroGridViewHeaderStyle}">
                        <GridViewColumn Header="Name"
                                        Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type local:MacroItemViewModel}">
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ItemToolTip}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Triggers"
                                        Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type local:MacroItemViewModel}">
                                    <TextBlock x:Name="TriggerText"
                                               Text="{Binding TriggersSummary}"
                                               ToolTip="{Binding TriggersDetail}"
                                               TextTrimming="CharacterEllipsis" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSample}" Value="True">
                                            <Setter TargetName="TriggerText" Property="Text" Value="" />
                                            <Setter TargetName="TriggerText" Property="ToolTip" Value="{x:Null}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="32">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type local:MacroItemViewModel}">
                                    <Button Click="PrimaryActionButton_Click"
                                            ToolTip="{Binding PrimaryActionToolTip}"
                                            AutomationProperties.Name="{Binding PrimaryActionAutomationName}"
                                            IsEnabled="{Binding CanPrimaryAction}"
                                            Padding="2"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <imaging:CrispImage x:Name="PrimaryActionIcon"
                                                            Width="14"
                                                            Height="14"
                                                            Moniker="{x:Static catalog:KnownMonikers.Run}" />
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSample}" Value="True">
                                            <Setter TargetName="PrimaryActionIcon" Property="Moniker" Value="{x:Static catalog:KnownMonikers.Open}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <StaticResource ResourceKey="MacroListViewItemStyle" />
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander x:Name="GroupExpander"
                                                      Margin="0,10,0,0"
                                                      Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
                                                <Expander.Style>
                                                    <Style TargetType="Expander" BasedOn="{StaticResource GroupExpanderStyle}">
                                                        <Setter Property="IsExpanded" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="Samples">
                                                                <Setter Property="IsExpanded" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Expander.Style>
                                                <Expander.Header>
                                                    <Border Background="Transparent"
                                                            PreviewMouseRightButtonUp="MacroGroupHeader_PreviewMouseRightButtonUp">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                            <Run Text=" (" />
                                                            <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                                            <Run Text=")" />
                                                        </TextBlock>
                                                    </Border>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <!-- Empty-state placeholder, layered on top so it appears centered when no group
                 has any rows visible. The IsEmpty property already accounts for the active
                 filter text, so this also doubles as the "no results" message. -->
            <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       Text="No macros yet. Press Ctrl+Shift+R to start recording, then save it."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="16"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
        </Grid>
    </DockPanel>
</UserControl>
