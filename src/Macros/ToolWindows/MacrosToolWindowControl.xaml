<UserControl x:Class="Macros.ToolWindows.MacrosToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:Macros.ToolWindows"
             mc:Ignorable="d"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             AutomationProperties.Name="Macros tool window"
             d:DesignHeight="400" d:DesignWidth="320">

    <UserControl.Resources>
        <!-- Built-in WPF converter is sufficient for the simple bool→Visibility mappings the
             empty-state, error banner, and group headers need. No inversion required. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Toolbar -->
            <RowDefinition Height="Auto" /> <!-- 1: Search/filter -->
            <RowDefinition Height="*" />    <!-- 2: Group list / empty state -->
            <RowDefinition Height="Auto" /> <!-- 3: Status banner -->
        </Grid.RowDefinitions>

        <!-- ─── Toolbar ─────────────────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarToolBarBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="4,2">
                <Button Command="{Binding RefreshCommand}"
                        ToolTip="Refresh macro list"
                        AutomationProperties.Name="Refresh"
                        Padding="6,4"
                        Margin="0,0,2,0"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.Refresh}" />
                </Button>
                <Button Command="{Binding RecordCommand}"
                        ToolTip="New macro from current recording"
                        AutomationProperties.Name="New macro from recording"
                        Padding="6,4"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <imaging:CrispImage Width="16" Height="16"
                                        Moniker="{x:Static catalog:KnownMonikers.Record}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ─── Filter box ──────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="4,4,4,2">
            <TextBox x:Name="FilterBox"
                     AutomationProperties.Name="Filter macros"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                     Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                     Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"
                     BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                     Padding="4,3" />
            <!-- Lightweight watermark: a TextBlock layered on top, hidden whenever the box has
                 focus or content. WPF still doesn't ship a native PlaceholderText. -->
            <TextBlock IsHitTestVisible="False"
                       Margin="8,5,4,4"
                       Text="Filter macros…"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- ─── Macro list / empty state ────────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}"
                              AutomationProperties.Name="Saved macros">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MacroGroupViewModel}">
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                      Margin="0,2,0,0"
                                      Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Header}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding VisibleItems}"
                                              Margin="12,2,2,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:MacroItemViewModel}">
                                            <Border Margin="0,1"
                                                    Padding="4,3"
                                                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                            <TextBlock Text="{Binding LastModifiedDisplay}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
                                                            <TextBlock Text=" · "
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
                                                            <TextBlock Text="{Binding SizeDisplay}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding PlayCommand}"
                                                            ToolTip="Play macro"
                                                            AutomationProperties.Name="Play macro"
                                                            Padding="4"
                                                            Margin="4,0,0,0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent">
                                                        <imaging:CrispImage Width="14" Height="14"
                                                                            Moniker="{x:Static catalog:KnownMonikers.Run}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty-state placeholder, layered on top so it appears centered when no group
                 has any rows visible. The IsEmpty property already accounts for the active
                 filter text, so this also doubles as the "no results" message. -->
            <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       Text="No macros yet. Press Ctrl+Shift+R to start recording, then save it."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="16"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
        </Grid>

        <!-- ─── Status banner (errors only) ─────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.SystemInfoBackgroundBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemInfoTextBrushKey}}" />
        </Border>
    </Grid>
</UserControl>
