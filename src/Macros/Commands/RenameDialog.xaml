<vsui:DialogWindow x:Class="Macros.Commands.RenameDialog"
                   x:ClassModifier="internal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                   Title="Rename Macro"
                   WindowStartupLocation="CenterOwner"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   SizeToContent="WidthAndHeight"
                   MinWidth="380"
                   HasMinimizeButton="False"
                   HasMaximizeButton="False">

    <vsui:DialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </vsui:DialogWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Row 0: Label showing old name + scope -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding OldName, StringFormat='Rename {0} to:'}"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.DialogTextBrushKey}}" />

        <!-- Row 1: New name TextBox -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="New name:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.DialogTextBrushKey}}" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="NewNameTextBox"
                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                 MinWidth="260"
                 Margin="0,0,0,8"
                 Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"
                 Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                 BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />

        <!-- Row 2: Validation message (hidden when empty) -->
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />

        <!-- Row 3: Spacer (height defined above) -->

        <!-- Row 4: Rename / Cancel buttons -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Rename"
                    IsDefault="True"
                    IsEnabled="{Binding CanRename}"
                    MinWidth="75"
                    Margin="0,0,8,0"
                    Click="RenameButton_Click" />
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="75"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>

</vsui:DialogWindow>
