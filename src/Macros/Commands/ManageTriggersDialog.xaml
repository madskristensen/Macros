<vsui:DialogWindow x:Class="Macros.Commands.ManageTriggersDialog"
                   x:ClassModifier="internal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                   xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
                   xmlns:local="clr-namespace:Macros.Commands"
                   xmlns:triggers="clr-namespace:Macros.Engine.Triggers;assembly=Macros.Engine"
                   toolkit:Themes.UseVsTheme="True"
                   Title="Manage Triggers"
                   AutomationProperties.Name="Manage Triggers"
                   WindowStartupLocation="CenterOwner"
                   MinWidth="600"
                   MinHeight="420"
                   Width="640"
                   Height="480"
                   ShowInTaskbar="False"
                   HasMinimizeButton="False"
                   HasMaximizeButton="False">

    <!-- Accessibility:
         - DialogWindow exposes AutomationProperties.Name matching the title.
         - Bindings ListBox carries an AutomationProperties.Name so screen readers announce
           "Trigger bindings" when focus enters the list.
         - Per-row Remove button has AutomationProperties.Name bound to the binding summary
           ("Remove {DisplaySummary}") so each row's button is distinguishable in
           Narrator's element tree.
         - Kind ComboBox is labelled by the "Kind:" TextBlock; Name TextBox by "Name:";
           Filters TextBox by "Filters:". All via AutomationProperties.LabeledBy.
         - Tab order follows document order: Bindings list → Kind → Add → Name → Filters →
           Save → Cancel.
         - Add button has access key (_Add / Alt+A); Save (_Save) and Cancel (_Cancel) have
           IsDefault / IsCancel respectively for Enter/Esc handling.
         - Validation TextBlock uses AutomationProperties.LiveSetting="Polite".
         - Initial focus moves to the Kind ComboBox in the Loaded handler (code-behind).
    -->

    <vsui:DialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </vsui:DialogWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header label "Triggers for {MacroName}" -->
        <TextBlock Grid.Row="0"
                   Text="{Binding MacroName, StringFormat='Triggers for {0}'}"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <!-- Row 1: ListBox of current bindings + per-row Remove button -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding Bindings}"
                     AutomationProperties.Name="Trigger bindings"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TriggerBindingViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplaySummary}"
                                       ToolTip="{Binding DisplayDetail}"
                                       VerticalAlignment="Center"
                                       Margin="4,2" />
                            <Button Grid.Column="1"
                                    Content="Remove"
                                    Command="{Binding RemoveCommand}"
                                    AutomationProperties.Name="{Binding DisplaySummary, StringFormat='Remove {0}'}"
                                    MinWidth="70"
                                    Margin="8,2,4,2" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Row 2: Add new trigger panel -->
        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.PanelBorderBrushKey}}"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="Add trigger"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <!-- Kind picker -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           x:Name="KindLabel"
                           Text="Kind:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4" />
                <ComboBox Grid.Row="1" Grid.Column="1"
                          x:Name="KindCombo"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding NewTriggerKind, Mode=TwoWay}"
                          AutomationProperties.LabeledBy="{Binding ElementName=KindLabel}"
                          Margin="0,0,8,4">
                    <ComboBoxItem Content="VS Event" Tag="{x:Static triggers:TriggerKind.VsEvent}" />
                    <ComboBoxItem Content="Before Command" Tag="{x:Static triggers:TriggerKind.BeforeCommand}" />
                    <ComboBoxItem Content="After Command" Tag="{x:Static triggers:TriggerKind.AfterCommand}" />
                    <ComboBoxItem Content="Manual" Tag="{x:Static triggers:TriggerKind.Manual}" />
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="2"
                        Content="_Add"
                        IsEnabled="{Binding CanAddTrigger}"
                        AutomationProperties.Name="Add trigger"
                        MinWidth="75"
                        Margin="0,0,0,4"
                        Click="AddButton_Click" />

                <!-- Name input -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           x:Name="NameLabel"
                           Text="Name:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"
                           Visibility="{Binding IsNameRequired, Converter={StaticResource BoolToVis}}" />
                <!-- Event picker: editable ComboBox seeded from KnownEvents (VS.Events catalog).
                     IsEditable lets the user type a custom event name; IsTextSearchEnabled
                     filters the dropdown as they type. Visible only when Kind == VsEvent. -->
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          x:Name="EventNameCombo"
                          ItemsSource="{Binding KnownEvents}"
                          DisplayMemberPath="CanonicalName"
                          TextSearch.TextPath="CanonicalName"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True"
                          Text="{Binding NewTriggerName, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                          Visibility="{Binding IsVsEvent, Converter={StaticResource BoolToVis}}"
                          Margin="0,0,0,4" />
                <!-- Plain command-name TextBox: used for BeforeCommand / AfterCommand. -->
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                         x:Name="NameTextBox"
                         Text="{Binding NewTriggerName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                         Visibility="{Binding IsCommandName, Converter={StaticResource BoolToVis}}"
                         Margin="0,0,0,4" />

                <!-- Filters input (only meaningful for VsEvent) -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           x:Name="FiltersLabel"
                           Text="Filters:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Visibility="{Binding AreFiltersAvailable, Converter={StaticResource BoolToVis}}" />
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding NewTriggerFilters, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.LabeledBy="{Binding ElementName=FiltersLabel}"
                         Visibility="{Binding AreFiltersAvailable, Converter={StaticResource BoolToVis}}"
                         ToolTip="Optional. Format: key=value and key2=value2" />
            </Grid>
        </Border>

        <!-- Row 3: Validation message (hidden when empty) -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Validation message"
                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />

        <!-- Row 4: Save / Cancel buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="_Save"
                    IsDefault="True"
                    AutomationProperties.Name="Save"
                    MinWidth="75"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click" />
            <Button Content="_Cancel"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel"
                    MinWidth="75"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>

</vsui:DialogWindow>
