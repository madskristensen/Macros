<vsui:DialogWindow x:Class="Macros.Commands.SaveAsDialog"
                   x:ClassModifier="internal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                   Title="Save Macro As"
                   WindowStartupLocation="CenterOwner"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   SizeToContent="WidthAndHeight"
                   MinWidth="400"
                   HasMinimizeButton="False"
                   HasMaximizeButton="False">

    <vsui:DialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </vsui:DialogWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Row 0: Name label + TextBox -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Name:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.DialogTextBrushKey}}" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 x:Name="NameTextBox"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 MinWidth="280"
                 Margin="0,0,0,8"
                 Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"
                 Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                 BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />

        <!-- Row 1: Scope label + RadioButtons -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Scope:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.DialogTextBrushKey}}" />
        <StackPanel Grid.Row="1" Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <RadioButton Content="Global"
                         IsChecked="{Binding IsGlobalScope, Mode=TwoWay}"
                         Margin="0,0,16,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.DialogTextBrushKey}}" />
            <RadioButton Content="Repo"
                         IsChecked="{Binding IsRepoScope, Mode=TwoWay}"
                         IsEnabled="{Binding IsRepoEnabled}"
                         ToolTipService.ShowOnDisabled="True"
                         ToolTip="Repo scope requires an open solution."
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.DialogTextBrushKey}}" />
        </StackPanel>

        <!-- Row 2: Validation message (hidden when empty) -->
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />

        <!-- Row 3: Spacer (height defined above) -->

        <!-- Row 4: Save / Cancel buttons -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Save"
                    IsDefault="True"
                    IsEnabled="{Binding CanSave}"
                    MinWidth="75"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click" />
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="75"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>

</vsui:DialogWindow>
