<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>

    <RootNamespace>Macros</RootNamespace>
    <AssemblyName>Macros</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <!-- Files included inside the VSIX archive -->
  <ItemGroup>
    <Content Include="LICENSE">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!-- VSIX manifest (Designer + VSSDK build action) -->
  <ItemGroup>
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
      <Generator>VsixManifestGenerator</Generator>
      <LastGenOutput>source.extension.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- VSCT command table -->
  <ItemGroup>
    <AvailableItemName Include="VSCTCompile" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="VSCommandTable.vsct" />
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <Generator>VsctGenerator</Generator>
      <LastGenOutput>VSCommandTable.cs</LastGenOutput>
    </VSCTCompile>
  </ItemGroup>

  <!-- Auto-generated VSCommandTable.cs (use Update because SDK auto-globs *.cs) -->
  <ItemGroup>
    <Compile Update="VSCommandTable.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>VSCommandTable.vsct</DependentUpon>
    </Compile>
    <!-- Per the comment at the top of PackageIds.cs, the VsctGenerator only runs inside the
         VS IDE; dotnet build relies on the hand-maintained PackageGuids.cs / PackageIds.cs
         mirror instead. When VS does regenerate VSCommandTable.cs (e.g. during interactive
         development), it duplicates those types and breaks the build. Excluding the generated
         file from compilation keeps the source file present on disk for VS while letting the
         hand-authored mirror remain canonical at build time. -->
    <Compile Remove="VSCommandTable.cs" />
    <None Include="VSCommandTable.cs">
      <DependentUpon>VSCommandTable.vsct</DependentUpon>
    </None>
  </ItemGroup>

  <!-- .NET Framework assemblies not covered by NuGet -->
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.549" ExcludeAssets="Runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Community.VisualStudio.VSCT" Version="16.0.29.6" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.11.0" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.13.61" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Macros.Engine\Macros.Engine.csproj" />
  </ItemGroup>

  <!-- Grant the unit-test project access to internal members (LastPlayTask, SaveAsDialogViewModel,
       etc.) that tests need to assert on without making them part of the public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Macros.Tests" />
  </ItemGroup>

</Project>
