<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>

    <RootNamespace>Macros</RootNamespace>
    <AssemblyName>Macros</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <!-- Files included inside the VSIX archive -->
  <ItemGroup>
    <Content Include="Resources\Icon.png" />
    <Content Include="Resources\LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Samples\collapse-regions-on-open.csx" />
    <None Remove="Samples\collapse-all-regions.csx" />
    <None Remove="Samples\convert-to-uppercase.csx" />
    <None Remove="Samples\delete-blank-lines.csx" />
    <None Remove="Samples\format-on-save-csharp.csx" />
    <None Remove="Samples\insert-file-header.csx" />
    <None Remove="Samples\insert-timestamp.csx" />
    <None Remove="Samples\insert-todo-with-date.csx" />
    <None Remove="Samples\log-document-path.csx" />
    <None Remove="Samples\open-matching-test-file.csx" />
    <None Remove="Samples\show-build-error-count.csx" />
    <None Remove="Samples\sort-selected-lines.csx" />
    <None Remove="Samples\surround-with-region.csx" />
    <None Remove="Samples\toggle-comment-style.csx" />
    <None Remove="Samples\wrap-in-try-catch.csx" />
    <EmbeddedResource Include="Samples\collapse-regions-on-open.csx">
      <LogicalName>collapse-regions-on-open.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\collapse-all-regions.csx">
      <LogicalName>collapse-all-regions.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\convert-to-uppercase.csx">
      <LogicalName>convert-to-uppercase.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\delete-blank-lines.csx">
      <LogicalName>delete-blank-lines.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\format-on-save-csharp.csx">
      <LogicalName>format-on-save-csharp.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\insert-file-header.csx">
      <LogicalName>insert-file-header.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\insert-timestamp.csx">
      <LogicalName>insert-timestamp.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\insert-todo-with-date.csx">
      <LogicalName>insert-todo-with-date.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\log-document-path.csx">
      <LogicalName>log-document-path.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\open-matching-test-file.csx">
      <LogicalName>open-matching-test-file.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\show-build-error-count.csx">
      <LogicalName>show-build-error-count.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\sort-selected-lines.csx">
      <LogicalName>sort-selected-lines.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\surround-with-region.csx">
      <LogicalName>surround-with-region.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\toggle-comment-style.csx">
      <LogicalName>toggle-comment-style.csx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Samples\wrap-in-try-catch.csx">
      <LogicalName>wrap-in-try-catch.csx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Skills\Content\*.md" />
    <EmbeddedResource Include="Skills\Content\writing-macros.md">
      <LogicalName>Macros.Skills.Content.writing-macros.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Skills\Content\macro-triggers.md">
      <LogicalName>Macros.Skills.Content.macro-triggers.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Skills\Content\macro-dte-api.md">
      <LogicalName>Macros.Skills.Content.macro-dte-api.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Skills\Content\macro-toolkit-api.md">
      <LogicalName>Macros.Skills.Content.macro-toolkit-api.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Skills\Content\macro-debugging.md">
      <LogicalName>Macros.Skills.Content.macro-debugging.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- VSIX manifest (Designer + VSSDK build action) -->
  <ItemGroup>
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
      <Generator>VsixManifestGenerator</Generator>
      <LastGenOutput>source.extension.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- VSCT command table -->
  <ItemGroup>
    <AvailableItemName Include="VSCTCompile" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\Icon.png" />
    <None Remove="Resources\LICENSE" />
    <None Remove="VSCommandTable.vsct" />
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <Generator>VsctGenerator</Generator>
      <LastGenOutput>VSCommandTable.cs</LastGenOutput>
    </VSCTCompile>
  </ItemGroup>

  <!-- Auto-generated VSCommandTable.cs is included by SDK auto-glob. Add metadata to nest under .vsct. -->
  <ItemGroup>
    <Compile Update="source.extension.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>source.extension.vsixmanifest</DependentUpon>
    </Compile>
    <Compile Update="VSCommandTable.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>VSCommandTable.vsct</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- .NET Framework assemblies not covered by NuGet -->
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.549" ExcludeAssets="Runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Community.VisualStudio.VSCT" Version="16.0.29.6" PrivateAssets="all" />

    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.13.61" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Package satellite resource (VSPackage.resources) consumed by the VS shell to look up
       string resource IDs referenced from package attributes such as ProvideKeyBindingTable.
       LogicalName must be exactly "VSPackage.resources" (no root namespace prefix) so the
       shell can find it; SDK-style projects otherwise prepend the root namespace. -->
  <ItemGroup>
    <EmbeddedResource Update="VSPackage.resx">
      <ManifestResourceName>VSPackage</ManifestResourceName>
      <MergeWithCTO>true</MergeWithCTO>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Macros.Engine\Macros.Engine.csproj" />
  </ItemGroup>

  <!-- Grant the unit-test project access to internal members (LastPlayTask, SaveAsDialogViewModel,
       etc.) that tests need to assert on without making them part of the public API. -->
  <!-- DynamicProxyGenAssembly2 is required so Moq can create proxies for internal interfaces
       (e.g. IDeleteCommandUI) in unit tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Macros.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
